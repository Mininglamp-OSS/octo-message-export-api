# octo-message-export-api 环境变量样例
# 复制为 .env 后按实际填写：cp .env.example .env

# HTTP 监听
HTTP_ADDR=:8080

# 优雅关闭摘流宽限期（毫秒）：SIGTERM 收到后先让 /readyz 转不就绪，
# 等这段时间让 LB 摘流再 Shutdown，规避滚动更新偶发 502。
DRAIN_GRACE_MS=5000

# OpenSearch（多节点逗号分隔）
OS_ENDPOINTS=http://127.0.0.1:9200
OS_INDEX_NAME=messages
OS_USERNAME=
OS_PASSWORD=
OS_INSECURE_SKIP_VERIFY=false
OS_MAX_CONNS=200
PIT_KEEP_ALIVE=5m

# MySQL（task / parts 元数据）
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/octo_message_export_api?charset=utf8mb4&parseTime=true&loc=Local

# S3（results bucket）
S3_BUCKET=octo-message-export-api-results-test
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_TTL_SEC=3600

# 鉴权（s2s 长效 token，多个用逗号分隔）
AUTH_ENABLED=true
AUTH_S2S_TOKENS=
# caller→token 映射文件（可选；若提供则覆盖 AUTH_S2S_TOKENS 单 token 模式）
AUTH_CALLER_TOKENS_FILE=

# Executor
EXECUTOR_WORKERS=16
EXECUTOR_QUEUE_BUFFER=50
PART_DECOMPRESSED_MAX_BYTES=524288000
PART_MAX_ROWS=30000

# 系统保护参数
PROTECT_GLOBAL_INFLIGHT_MAX=50
PROTECT_SUBMIT_WAIT_SEC=10
PROTECT_MAX_TASK_HITS=300000
PER_CHANNEL_HARD_CAP=100000

# GC / 审计
TASK_RETENTION_DAYS=7
AUDIT_LOCAL_PATH=/var/log/octo-message-export-api/audit.jsonl
