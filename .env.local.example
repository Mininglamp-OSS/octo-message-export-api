# 本地 e2e 用环境变量（配合本地 docker-compose 服务）
# cp .env.local.example .env.local 后按实际填写

HTTP_ADDR=:18080
DRAIN_GRACE_MS=2000

# OpenSearch（本地无鉴权，端口按 compose 配置调整）
OS_ENDPOINTS=http://127.0.0.1:9201
OS_INDEX_NAME=messages
OS_USERNAME=
OS_PASSWORD=
OS_INSECURE_SKIP_VERIFY=true
OS_MAX_CONNS=50
PIT_KEEP_ALIVE=2m

# MySQL（本地 docker-compose 服务，端口按实际调整）
MYSQL_DSN=root:<CHANGEME>@tcp(127.0.0.1:23306)/octo_message_export_api?charset=utf8mb4&parseTime=true&loc=Local

# MinIO（本地 docker-compose 服务，端口按实际调整）
S3_ENDPOINT=http://127.0.0.1:29000
S3_BUCKET=octo-message-export-api-results-local
S3_REGION=us-east-1
S3_ACCESS_KEY=<CHANGEME>
S3_SECRET_KEY=<CHANGEME>
S3_USE_PATH_STYLE=true
S3_PRESIGN_TTL_SEC=3600

# 鉴权
AUTH_ENABLED=true
AUTH_S2S_TOKENS=changeme-token-smart-summary

# Executor / 保护参数（本地缩小）
EXECUTOR_WORKERS=4
EXECUTOR_QUEUE_BUFFER=20
PART_DECOMPRESSED_MAX_BYTES=10485760
PART_MAX_ROWS=2000
PROTECT_GLOBAL_INFLIGHT_MAX=10
PROTECT_SUBMIT_WAIT_SEC=5
PROTECT_MAX_TASK_HITS=300000
PER_CHANNEL_HARD_CAP=100000

# GC
TASK_RETENTION_DAYS=7
AUDIT_LOCAL_PATH=./audit.jsonl
